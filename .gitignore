# Builds live in ..\Builds\, outside the repo. Safety net in case one lands here.
Builds/
*.exe
*.exe.old

# Settings and data live outside the repo (%APPDATA%\<App Name>, or <project>\Data for
# private tools). These catch a stray copy if one is ever left in here.
Data/

# Icons live in ..\Icons\, outside the repo: the logos belong to their projects,
# so they're never published. This catches a stray copy.
Icons/

# Local config and secrets
config.local.json
.env
secrets*.json
*.key
*.pfx

# Logs, temp files and backups (Build-Exe.log, editor backups)
*.log
*.tmp
*.bak

# Windows clutter
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Editor
.vscode/
*.swp
